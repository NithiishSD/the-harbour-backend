# ─────────────────────────────────────────────────────────────────────────────
# HarbourWatch — Portainer environment-variable checklist
#
# Paste these names + safe defaults into Portainer → Stack → Environment variables.
# Fill in real values for secrets.  Do NOT commit a file that contains real secrets.
#
# Portainer CANNOT read a .env file from the filesystem; every variable must be
# entered in the UI or via Portainer's secret store.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets (no default — must be filled in) ────────────────────────
AISSTREAM_API_KEY=                  # your aisstream.io API key

# ── Image pins (update these when you push a new build) ──────────────────────
APP_IMAGE=ghcr.io/nithiishsd/the-harbour-backend-backend:sha-2df774a
HBASE_IMAGE=ghcr.io/nithiishsd/the-harbour-backend-hbase:2.6.7

# ── Monitoring target ────────────────────────────────────────────────────────
MONITOR_COUNTRY=SG
MONITOR_PORTS=
MONITOR_PARTNERS=auto
MONITOR_WATERS=
MONITOR_REGION_KM=150
MONITOR_MAX_PARTNERS=10
MONITOR_MIN_PARTNERS=5
MONITOR_AIS_PAD=2
MONITOR_AIS_REGION_KM=800
MONITOR_AIS_SOURCE_KM=500
MONITOR_FOLLOWABLE_HOURS=48
MONITOR_SOURCE_PORT_KM=60
MONITOR_STOP_KM=15
MONITOR_LEFT_KM=30
MONITOR_SLOW_KN=1.5
MONITOR_TIMEZONE=

# ── Live AIS subscription area (leave blank to auto-derive) ──────────────────
LIVE_BBOX=

# ── Map display rules ────────────────────────────────────────────────────────
MAP_TRANSIT_HOURS=6
MAP_ARRIVED_HOURS=24
MAP_SILENT_HOURS=24

# ── Alert thresholds ─────────────────────────────────────────────────────────
DARK_TIMEOUT_HOURS=6
MIN_ACTIVE_SHIPS=3
QUEUE_GROWTH_PCT=50
QUEUE_GROWTH_MIN=5

# ── Data retention ───────────────────────────────────────────────────────────
LIVE_SINCE=2026-10-10          # date the live feed started; older non-NOAA data = test data
HISTORY_MAX_MB=1024            # max size of data/history before oldest days are pruned
COLD_MAX_MB=2048               # max size of data/cold (raw Kafka archive)

# ── Ship following (ingest.follow — profile: live) ───────────────────────────
FOLLOW_MAX=200
FOLLOW_DAYS=30
FOLLOW_REFRESH_S=300

# ── Dashboard performance ─────────────────────────────────────────────────────
SHIPS_CACHE_S=2
HISTORY_EVERY_S=600

# ── Spark / streaming tuning ─────────────────────────────────────────────────
STREAM_SPARK_MASTER=local[2]
STREAM_DRIVER_MEMORY=1g
STREAM_SPARK_UI=0
STREAM_MEM_LIMIT=3g
STREAM_CPUS=2

# ── One-shot nightly batch (profile: batch) ───────────────────────────────────
NIGHTLY_DATE=2026-10-13        # set to yesterday's date before running
