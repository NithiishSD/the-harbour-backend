# Copy to .env and fill in. Real environment variables take precedence.
# Default deployment: Singapore (MONITOR_COUNTRY=SG), live aisstream.io feed.
# NOAA files are NOT used in this configuration — see the NOAA section at the
# bottom if you are switching to MONITOR_COUNTRY=US.

# aisstream.io API key — required for the live feed (ingest.aisstream / ingest.follow)
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream

KAFKA_BOOTSTRAP=localhost:9092
HBASE_REST_URL=http://localhost:8080
DATA_DIR=./data

# Live AIS subscription area: min_lat,min_lon,max_lat,max_lon, several separated by ';'.
# Unset (recommended): derived automatically from MONITOR_COUNTRY and MONITOR_PARTNERS.
# Override example for Singapore Strait only:
# LIVE_BBOX=1.0,103.5,1.5,104.3

# ---- What is monitored (common/monitor.py) ----
# The country is fixed for a deployment; switching country is a full redeploy
# (the replay and reports will then show only the new country's data).
MONITOR_COUNTRY=SG
# Ports to monitor, UN/LOCODEs separated by ',' (dashboard port panel narrows them); empty = all
MONITOR_PORTS=
# Source countries, ISO codes separated by ',': ships bound to/from monitored ports are shown.
# `auto` picks countries whose voyages coastal AIS can follow end-to-end.
MONITOR_PARTNERS=auto
# The country's own sea: boxes min_lat,min_lon,max_lat,max_lon separated by ';'.
# Unset: uses geo/national_waters.csv; otherwise uses MONITOR_REGION_KM around each port.
MONITOR_WATERS=
MONITOR_REGION_KM=150
MONITOR_MAX_PARTNERS=10
MONITOR_MIN_PARTNERS=5
# AIS subscription coverage: lanes widened by MONITOR_AIS_PAD (5-degree squares),
# plus this many km around monitored ports and source-country ports.
# Run `python -m ingest.coverage_survey` to visualise receiver coverage.
MONITOR_AIS_PAD=2
MONITOR_AIS_REGION_KM=800
MONITOR_AIS_SOURCE_KM=500
# A voyage blind (outside coastal AIS range) up to this many hours still counts as followed
MONITOR_FOLLOWABLE_HOURS=48
# Port proximity rules: a ship's first report within SOURCE_PORT_KM of a port is "at" it;
# it is stopped when within STOP_KM at under SLOW_KN knots; it has left once LEFT_KM away.
MONITOR_SOURCE_PORT_KM=60
MONITOR_STOP_KM=15
MONITOR_LEFT_KM=30
MONITOR_SLOW_KN=1.5

# How long ships stay on the map (hours of feed time).
# Ships shown only for being in the country's waters are prioritised for removal.
MAP_TRANSIT_HOURS=6
MAP_ARRIVED_HOURS=24
MAP_SILENT_HOURS=24

# Dark-ship rule: flag a ship that goes silent for this long while >= MIN_ACTIVE_SHIPS neighbours report
DARK_TIMEOUT_HOURS=6
MIN_ACTIVE_SHIPS=3

# Queue growth alert: flag when window count grows by this % and by at least this many ships
QUEUE_GROWTH_PCT=50
QUEUE_GROWTH_MIN=5

# The live feed has been running since this date.
# Days before this date that are not NOAA files are treated as test data (common/testdata.py).
LIVE_SINCE=2026-10-10

# Size caps for what the live feed leaves behind (batch.archive_history removes oldest days first).
# NOAA files are never removed.
# Local max: 20480 (20GB) / 51200 (50GB). Prod safe default: 1024 / 2048.
HISTORY_MAX_MB=20480
COLD_MAX_MB=51200

# ---- Following ships worldwide (ingest/follow.py, the `follow` service) ----
# Ships that left a monitored port (or are bound for one) are subscribed by MMSI globally.
# Local max: 2000. Prod safe default: 200.
FOLLOW_MAX=2000
FOLLOW_DAYS=90
FOLLOW_REFRESH_S=60

# ---- Spark / container tuning (High-Performance Local vs Safe Cloud) ----
# Local maximums: local[*], 4g heap, 32 partitions, 1s trigger
SPARK_MASTER=local[*]
STREAM_SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
STREAM_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=32
SPARK_UI=1
STREAM_SPARK_UI=1
STREAM_TRIGGER_S=1
STREAM_MEM_LIMIT=8g
STREAM_CPUS=8

# Dashboard ship-list cache: one scan shared between viewers for this many seconds
SHIPS_CACHE_S=5
# Seconds between archive-history runs (flushes Parquet micro-partitions)
HISTORY_EVERY_S=120
NIGHTLY_EVERY_S=1800
DASHBOARD_WORKERS=4
DASHBOARD_MEM_LIMIT=2048m
DASHBOARD_CPUS=4
KAFKA_MEM_LIMIT=2048m
HBASE_MEM_LIMIT=4096m

# Dashboard timezone (IANA name); empty = derived from MONITOR_COUNTRY via geo/timezones.csv, else UTC
MONITOR_TIMEZONE=

# ──────────────────────────────────────────────────────────────────────────────
# NOAA / US-waters mode  (only relevant when MONITOR_COUNTRY=US)
# ──────────────────────────────────────────────────────────────────────────────
# NOAA MarineCadastre daily CSV files cover US coastal waters only.
# They are NOT downloaded or used in the default Singapore deployment.
#
# To switch to US mode:
#   1. Set MONITOR_COUNTRY=US and redeploy the full stack.
#   2. Download NOAA data:
#        python -m ingest.noaa --date 2023-01-01 --bbox 33.4,-118.6,33.9,-117.9
#   3. Run the nightly batch WITHOUT --live (it fetches/uses the NOAA CSV):
#        python -m batch.nightly --date 2023-01-01
#
# Monitored US ports (UN/LOCODEs): USLGB (Long Beach), USLAX (Los Angeles)
# Default NOAA bbox (LA / Long Beach): 33.4,-118.6,33.9,-117.9
