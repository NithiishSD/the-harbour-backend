# ─────────────────────────────────────────────────────────────────────────────
# HarbourWatch — VM 1 environment (Compute, Analytics & Application Node)
# Place this file next to docker-compose.vm1-compute.yml on the compute VM.
# ─────────────────────────────────────────────────────────────────────────────

# ── Connection to VM 2 (storage node) ────────────────────────────────────────
# The private IP of the storage VM (VM 2). All services connect to Kafka and HBase
# through this address. Replace with the actual private IP of VM 2.
VM2_PRIVATE_IP=REPLACE_WITH_VM2_PRIVATE_IP

# ── Application image ────────────────────────────────────────────────────────
APP_IMAGE=ghcr.io/nithiishsd/the-harbour-backend-backend:latest

# ── Live AIS feed (leave blank to fall back to NOAA replay) ──────────────────
AISSTREAM_API_KEY=

# ── Global AIS subscription (entire world) ───────────────────────────────────
LIVE_BBOX=-90.0,-180.0,90.0,180.0

# ── Monitoring scope: United States, all ports, global partners ──────────────
MONITOR_COUNTRY=US
MONITOR_PORTS=
MONITOR_PARTNERS=auto
MONITOR_WATERS=
MONITOR_REGION_KM=150
MONITOR_MAX_PARTNERS=50
MONITOR_MIN_PARTNERS=20

# ── AIS listening coverage (expanded for global reach) ───────────────────────
MONITOR_AIS_PAD=4
MONITOR_AIS_REGION_KM=1500
MONITOR_AIS_SOURCE_KM=1000
MONITOR_FOLLOWABLE_HOURS=96

# ── Port proximity rules ────────────────────────────────────────────────────
MONITOR_SOURCE_PORT_KM=60
MONITOR_STOP_KM=15
MONITOR_LEFT_KM=30
MONITOR_SLOW_KN=1.5

# ── Alert thresholds ────────────────────────────────────────────────────────
DARK_TIMEOUT_HOURS=6
MIN_ACTIVE_SHIPS=3
QUEUE_GROWTH_PCT=50
QUEUE_GROWTH_MIN=5

# ── Map keep times (extended for ocean crossings) ───────────────────────────
MAP_TRANSIT_HOURS=24
MAP_ARRIVED_HOURS=48
MAP_SILENT_HOURS=48

# ── Data lifecycle ──────────────────────────────────────────────────────────
LIVE_SINCE=2026-10-10
HISTORY_MAX_MB=1024
COLD_MAX_MB=2048

# ── Worldwide ship following ────────────────────────────────────────────────
FOLLOW_MAX=200
FOLLOW_DAYS=14
FOLLOW_REFRESH_S=300

# ── Dashboard tuning ────────────────────────────────────────────────────────
SHIPS_CACHE_S=2
HISTORY_EVERY_S=600
MONITOR_TIMEZONE=

# ── Spark streaming engine (safe bounds for low-RAM VM 1) ───────────────────
STREAM_SPARK_MASTER=local[2]
STREAM_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4
STREAM_SPARK_UI=0
STREAM_TRIGGER_S=5
STREAM_MEM_LIMIT=2g
STREAM_CPUS=2

# ── Nightly batch frequency (seconds) ──────────────────────────────────────
NIGHTLY_EVERY_S=3600

# ── Frontend port ───────────────────────────────────────────────────────────
FRONTEND_PORT=80
