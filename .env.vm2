# ─────────────────────────────────────────────────────────────────────────────
# HarbourWatch — VM 2 environment (Storage & Messaging Node)
# Place this file next to docker-compose.vm2-storage.yml on the storage VM (VM 2).
# ─────────────────────────────────────────────────────────────────────────────

# The private IP of THIS machine (VM 2). Kafka advertises it so VM 1 can connect.
# Replace with the actual private IP of VM 2 (e.g. 10.0.0.6 or 172.31.20.20).
VM2_PRIVATE_IP=REPLACE_WITH_VM2_PRIVATE_IP

# HBase image (built and pushed by the build-hbase.yml GitHub Actions workflow)
HBASE_IMAGE=ghcr.io/nithiishsd/the-harbour-backend-hbase:2.6.7
